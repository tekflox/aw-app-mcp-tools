{
  "mcpServers": {
    "playwright": {
      "enabled": true,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.77",
        "--cdp-endpoint",
        "http://aw-app-browser:9223"
      ]
    },
    "mcp-tools-echo": {
      "enabled": true,
      "type": "stdio",
      "command": "python3",
      "args": [
        "-m",
        "mcp_tools_app.echo_server"
      ]
    }
  }
}
